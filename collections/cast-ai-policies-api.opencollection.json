{
  "opencollection": "1.0.0",
  "info": {
    "name": "CAST AI Kubernetes Cost Optimization AI Enabler Policies API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "CAST AI Get cluster policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cast.ai/v1/kubernetes/clusters/:clusterId/policies",
            "params": [
              {
                "name": "clusterId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the cluster."
              }
            ]
          },
          "docs": "Gets policies configuration for the target cluster."
        },
        {
          "info": {
            "name": "CAST AI Upsert cluster policies",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.cast.ai/v1/kubernetes/clusters/:clusterId/policies",
            "params": [
              {
                "name": "clusterId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the cluster."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upsert cluster's policies configuration."
        }
      ]
    }
  ],
  "bundled": true
}